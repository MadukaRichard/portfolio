# MongoDB connection string (MongoDB Atlas free tier works great)
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/portfolio
MONGODB_URI=

# Secret used to sign admin login sessions - use a long random string
JWT_SECRET=

# Admin login credentials
ADMIN_USERNAME=admin
# Generate this with: npm run hash-password -- yourPasswordHere
ADMIN_PASSWORD_HASH=

# Secret query param required to hit /api/seed once after first deploy
SEED_SECRET=
